{
  "name": "ists-protocol",
  "version": "0.9.0-beta",
  "description": "ISTS — Image-Serialized Transport & Storage Protocol. From-scratch lossless compressors (base-N, LZW, order-1 arithmetic, smart packer) plus a file⇄PNG codec. Zero runtime dependencies.",
  "main": "pack.js",
  "module": "pack.js",
  "files": [
    "codec.js",
    "lzw.js",
    "range.js",
    "pack.js",
    "filecodec.js",
    "index.html",
    "compress.html",
    "video.html",
    "scripts/generate-samples.js",
    "docs/samples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.js && node lzw.test.js && node pack.test.js && node filecodec.test.js",
    "samples": "node scripts/generate-samples.js",
    "start": "python -m http.server 8000"
  },
  "keywords": [
    "compression",
    "lossless",
    "text-compression",
    "base-n",
    "positional-encoding",
    "bigint",
    "entropy",
    "lzw",
    "arithmetic-coding",
    "range-coder",
    "png",
    "file-to-image",
    "steganography",
    "ists",
    "zero-dependencies"
  ],
  "author": "Upendra Gariminti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UpendraAkki/ists-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/UpendraAkki/ists-protocol/issues"
  },
  "homepage": "https://github.com/UpendraAkki/ists-protocol#readme",
  "engines": {
    "node": ">=12.0.0"
  }
}
